# PostgreSQL connection string (Neon / Supabase / local Postgres)
# Neon:     https://neon.tech  → create project → copy "Connection string"
# Supabase: https://supabase.com → Project Settings → Database → URI
# IMPORTANT: Use sslmode=verify-full for production
DATABASE_URL="postgresql://user:password@host:5432/justbin?sslmode=verify-full"

# Auth.js secret — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Base URL of the app (used by Auth.js)
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app (update after deployment)
AUTH_URL="http://localhost:3000"

# Required for self-hosted deployments (always set to true)
AUTH_TRUST_HOST="true"
